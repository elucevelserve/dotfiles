[Unit]
Description=Quickshell shell
BindsTo=niri.service
After=niri.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
Environment=QML2_IMPORT_PATH=%h/.local/lib/qt6/qml
ExecStart=/usr/bin/quickshell -c %h/.config/quickshell/
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri.service
