#!/bin/bash
set -euo pipefail

# install core + plasma packages (idempotent, no prompts)
sudo pacman -S --needed --noconfirm {{ range .packages.core.pacman }}{{ . }} {{ end }}
sudo pacman -S --needed --noconfirm {{ range .packages.plasma.pacman }}{{ . }} {{ end }}

# system services
sudo systemctl enable --now tuned-ppd

# user audio services
systemctl --user enable --now pipewire pipewire-pulse wireplumber

echo "Plasma installed."
