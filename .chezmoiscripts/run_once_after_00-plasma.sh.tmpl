#!/bin/bash
set -euo pipefail

# install packages (idempotent, no prompts)
sudo pacman -S --needed --noconfirm {{ range .packages.plasma.pacman }}{{ . }} {{ end }}

# don't enable sddm
sudo systemctl disable --now sddm 2>/dev/null || true

# system services
sudo systemctl enable --now cups power-profiles-daemon

# bluetooth only if hardware present
if ls /sys/class/bluetooth/ 2>/dev/null | grep -q .; then
  sudo systemctl enable --now bluetooth
fi

# user audio services
systemctl --user enable --now pipewire pipewire-pulse wireplumber

# start ly last, after all setup is done; disable the default getty on tty1
sudo systemctl enable --now ly@tty1.service
sudo systemctl disable --now getty@tty1.service 2>/dev/null || true

echo "Plasma installed. ly is starting now — log into 'Plasma (Wayland)'."
