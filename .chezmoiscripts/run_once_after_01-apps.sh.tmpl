#!/bin/bash
set -euo pipefail

# install config-file apps (idempotent, no prompts)
sudo pacman -S --needed --noconfirm {{ range .packages.apps.pacman }}{{ . }} {{ end }}

# switch login shell to zsh (via sudo: single password flow with built-in retries)
if [ "$SHELL" != "/usr/bin/zsh" ]; then
  sudo chsh -s /usr/bin/zsh "$USER"
fi

# install oh-my-zsh (not in official repos)
# NB: ~/.oh-my-zsh may already exist (chezmoi tracks custom/ for the theme), so
# the official installer aborts (it refuses if the dir exists). Instead, do
# what the installer does via git, which works in an existing dir and keeps
# the tracked custom/ theme intact.
if [ ! -f "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]; then
  git init --quiet "$HOME/.oh-my-zsh"
  git -C "$HOME/.oh-my-zsh" remote add origin https://github.com/ohmyzsh/ohmyzsh.git
  git -C "$HOME/.oh-my-zsh" fetch --depth=1 origin
  git -C "$HOME/.oh-my-zsh" checkout -b master origin/master
fi

# ensure the tracked .zshrc is in place now that oh-my-zsh is installed
chezmoi apply ~/.zshrc

echo "Apps installed. Shell is zsh + oh-my-zsh."
