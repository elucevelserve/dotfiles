#!/bin/bash
set -euo pipefail

# install config-file apps (idempotent, no prompts)
sudo pacman -S --needed --noconfirm {{ range .packages.apps.pacman }}{{ . }} {{ end }}

# switch login shell to zsh (usermod bypasses the /etc/shells check that chsh enforces)
if [ "$SHELL" != "/usr/bin/zsh" ]; then
  sudo usermod -s /usr/bin/zsh "$USER"
fi

# install oh-my-zsh (not in official repos)
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi

echo "Apps installed. Shell is zsh + oh-my-zsh."
