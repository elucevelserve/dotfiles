#!/bin/bash
set -euo pipefail

# install config-file apps (idempotent, no prompts)
sudo pacman -S --needed --noconfirm {{ range .packages.apps.pacman }}{{ . }} {{ end }}

# install oh-my-zsh (not in official repos) BEFORE switching the shell, so a
# failed chsh can't abort the script before oh-my-zsh is installed
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended --keep-zshrc
fi

# switch login shell to zsh (via sudo: single password flow with built-in retries)
if [ "$SHELL" != "/usr/bin/zsh" ]; then
  sudo chsh -s /usr/bin/zsh "$USER"
fi

echo "Apps installed. Shell is zsh + oh-my-zsh."
